# Banco de dados (MySQL / MariaDB)
DATABASE_URL="mysql://projectmed:projectmed@localhost:3306/projectmed"

# Sessão — em produção use valores aleatórios longos (64 bytes):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="troque-esta-chave-em-producao"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DIAS=7

# Criptografia de dados pessoais: 32 bytes aleatórios em base64 cada.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: se a DATA_ENCRYPTION_KEY de produção for perdida, os CPFs/telefones
# gravados ficam ilegíveis. Guarde uma cópia em local seguro (fora do GitHub).
DATA_ENCRYPTION_KEY=""
DATA_HMAC_KEY=""

# Servidor
PORT=3333
NODE_ENV="development"

# CORS — origem do frontend
WEB_ORIGIN="http://localhost:5173"

# Pagamento
# Provedor ativo: mock (dev, sem cobrança) | mercadopago
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="segredo-do-webhook"

# Endereço público do app (retorno do Mercado Pago; o MP não aceita localhost)
APP_URL="http://localhost:5173"

# Mercado Pago (developers > Suas integrações > Credenciais). Use as de TESTE no desenvolvimento.
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
# SÓ EM TESTE: e-mail do comprador de teste (painel do MP > Contas de teste). Em produção, vazio.
MERCADOPAGO_EMAIL_COMPRADOR_TESTE=""
# Chave secreta dos webhooks (painel do MP > Webhooks) — necessária em produção
MERCADOPAGO_WEBHOOK_SECRET=""

# Usuário master (admin — acessa o app sem assinatura). Criar com: npm run criar-master
# Use uma senha forte (12+ caracteres) e guarde num gerenciador de senhas.
MASTER_NOME=""
MASTER_EMAIL=""
MASTER_SENHA=""
