generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Usuário & Autenticação
// ──────────────────────────────────────────────

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique // sempre normalizado: minúsculas, sem espaços
  senhaHash String // Argon2id (hash bcrypt legado é refeito no próximo login)
  tipo      String   @default("R1")
  papel     String   @default("usuario") // usuario | admin (admin acessa o app sem assinatura)
  gatewayId String? // id do cliente no provedor de pagamento (cus_xxx)

  // Dados pessoais sensíveis: criptografados com AES-256-GCM (src/shared/crypto.ts).
  // O *Hash é um HMAC determinístico, só para detectar duplicados sem descriptografar.
  cpfCriptografado      String? @db.Text
  cpfHash               String? @unique
  telefoneCriptografado String? @db.Text

  emailVerificadoEm DateTime?
  termosAceitosEm   DateTime?
  termosVersao      String?

  // Proteção contra tentativa e erro de senha
  tentativasLoginFalhas Int       @default(0)
  bloqueadoAte          DateTime?
  ultimoLoginEm         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens   RefreshToken[]
  tokensUsoUnico  TokenUsoUnico[]
  revisoes        Revisao[]
  simulados       Simulado[]
  tarefas         Tarefa[]
  configAlgoritmo ConfigAlgoritmo?
  metaSemanal     MetaSemanal?
  assinatura      Assinatura?
  pagamentos      Pagamento[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  usuarioId String
  tokenHash String   @unique // SHA-256 do token; o token em si só existe no cookie do navegador
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// Links enviados por e-mail (confirmar e-mail, redefinir senha). Guarda só o hash.
model TokenUsoUnico {
  id        String    @id @default(cuid())
  usuarioId String
  tipo      String // verificar_email | redefinir_senha
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
}

// ──────────────────────────────────────────────
// Billing — Planos, Assinaturas, Pagamentos
// ──────────────────────────────────────────────

model Plano {
  id        String   @id @default(cuid())
  nome      String // "Mensal", "Anual"
  preco     Int // centavos: 4990 = R$ 49,90
  intervalo String // "month" | "year"
  gatewayId String? // price/plan id no provedor
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  assinaturas Assinatura[]
}

model Assinatura {
  id           String    @id @default(cuid())
  usuarioId    String    @unique
  planoId      String
  status       String    @default("pendente") // pendente | trial | ativa | atrasada | cancelada | expirada
  gatewaySubId String? // id da assinatura no provedor
  validoAte    DateTime // ← o gate de acesso olha pra cá
  canceladaEm  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plano   Plano   @relation(fields: [planoId], references: [id])

  @@index([status])
}

model Pagamento {
  id           String   @id @default(cuid())
  usuarioId    String
  valor        Int
  status       String // pendente | aprovado | recusado | estornado
  metodo       String // pix | cartao | boleto
  gatewayPayId String   @unique // id da cobrança no provedor (idempotência)
  pixQrCode    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  gatewayId  String   @unique // dedupe: ignora evento repetido
  tipo       String
  payload    Json
  processado Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ──────────────────────────────────────────────
// Domínio (migração do localStorage — etapa seguinte)
// ──────────────────────────────────────────────

model Revisao {
  id                      String   @id @default(cuid())
  usuarioId               String
  tipo                    String // Questoes | Flashcards | Aula | Simulado
  grandeArea              String
  subArea                 String
  dataRevisao             String // YYYY-MM-DD
  tempoEstudo             Int      @default(0)
  questoesFeitas          Int      @default(0)
  questoesAcertadas       Int      @default(0)
  aproveitamento          Int      @default(0)
  status                  String // Pendente | Concluída | Atrasada
  proximaRevisao          String?
  gerarRevisaoInteligente Boolean  @default(true)
  createdAt               DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, dataRevisao])
  @@index([usuarioId, status])
}

model Simulado {
  id                String   @id @default(cuid())
  usuarioId         String
  titulo            String
  ano               String
  dataRealizacao    String
  tempoGasto        Int      @default(0)
  questoesTotal     Int
  questoesAcertadas Int
  nota              Int
  detalhePorArea    Json // DetalheAreaSimulado[]
  createdAt         DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Tarefa {
  id        String   @id @default(cuid())
  usuarioId String
  texto     String   @db.Text
  concluida Boolean  @default(false)
  createdAt DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model ConfigAlgoritmo {
  id        String @id @default(cuid())
  usuarioId String @unique
  faixas    Json // FaixaAlgoritmo[]

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model MetaSemanal {
  id        String @id @default(cuid())
  usuarioId String @unique
  meta      Int    @default(150)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}
